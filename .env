# Supabase configuration for the ManoFit Flutter app.
# NOTE: use the BARE project URL (no /rest/v1/ suffix) — the supabase_flutter
# SDK appends the REST path itself.
SUPABASE_URL=https://ognnnttqjbvmvjfvlpia.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im9nbm5udHRxamJ2bXZqZnZscGlhIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg4ODQ3NTAsImV4cCI6MjEwNDQ2MDc1MH0.hrOVam0N_VthJiTGqkjOdZTF-O1MLBBixXH-hufqSpk

# Synthetic email domain that Service IDs are mapped onto for Supabase auth.
AUTH_EMAIL_DOMAIN=manofit.app

# Tara voice companion — the URL the app opens in a WebView. The Node relay
# (SIH-2026/tara_service) holds the Gemini key; only this client URL lives here.
# USB handset: run `adb reverse tcp:3000 tcp:3000` and keep this on localhost
# (mic access needs a secure context — HTTPS or localhost).
TARA_URL=http://localhost:3000

# Analytics & ML microservice (FastAPI on port 8000).
# When running backends with tunnels, start-backends.ps1 automatically syncs
# live URLs to Supabase so manual pasting is never needed.
ML_URL=http://localhost:8000
