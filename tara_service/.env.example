# Tara voice service — copy to tara_service/.env and fill in.
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Port the Tara relay listens on. The Flutter app reaches it at TARA_URL
# (see SIH-2026/.env) — for a USB handset run `adb reverse tcp:3000 tcp:3000`
# and keep TARA_URL as http://localhost:3000 (a secure context, required for
# the WebView to get microphone access).
TARA_PORT=3000

# Gemini Live model / voice / language. Model + voice names shift between
# preview and GA — swap GEMINI_LIVE_MODEL if the default 404s.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Prebuilt voices — the Tara UI has a Female / Male toggle that picks between
# these two per conversation. See https://ai.google.dev/gemini-api/docs/live-guide
# for the full list.
#   Female calm picks: Leda (gentle), Sulafat (warm), Aoede (breezy),
#                      Vindemiatrix (gentle), Achernar (soft)
#   Male calm picks:   Achird (friendly), Algieba (smooth), Iapetus (clear),
#                      Charon (informative)
GEMINI_LIVE_VOICE_FEMALE=Leda
GEMINI_LIVE_VOICE_MALE=Achird
# Set GEMINI_LIVE_VOICE to pin ONE voice for everyone and ignore the toggle.
# GEMINI_LIVE_VOICE=

# Conversation language. `auto` lets Tara mirror the user and move freely
# between Hindi and English (incl. Hinglish). Pin it with `en` or `hi` if you
# want one fixed language. The in-app Auto / EN / हिं toggle overrides this
# per conversation.
GEMINI_LIVE_LANGUAGE=auto

# Model for the text chat panel (POST /chat) — a plain, non-Live Gemini model.
GEMINI_TEXT_MODEL=gemini-3.6-flash
